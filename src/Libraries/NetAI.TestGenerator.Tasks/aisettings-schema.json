{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "NetAI.TestGenerator Configuration",
  "type": "object",
  "required": [
    "version",
    "environment",
    "frameworks",
    "codeStyle",
    "generationBehavior",
    "aiConfiguration"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "The version of the configuration file.",
      "default": "1.1"
    },
    "environment": {
      "type": "object",
      "required": [ "targetDotNetVersion", "testProjectName" ],
      "properties": {
        "targetDotNetVersion": {
          "type": "string",
          "enum": [ "net6.0", "net7.0", "net8.0", "net9.0", "net10.0" ],
          "description": "The target .NET version for generated code."
        },
        "testProjectName": {
          "type": "string",
          "description": "Test project name. Use {ProjectName} as a placeholder."
        }
      }
    },
    "frameworks": {
      "type": "object",
      "required": [ "testFramework", "mockingFramework", "useFluentAssertions", "useAutoFixture" ],
      "properties": {
        "testFramework": {
          "type": "string",
          "enum": [ "xunit", "nunit", "mstest" ],
          "description": "The test framework to use."
        },
        "mockingFramework": {
          "type": "string",
          "enum": [ "moq", "nsubstitute", "fakeiteasy" ],
          "description": "The mocking framework to use."
        },
        "useFluentAssertions": {
          "type": "boolean",
          "description": "Whether to use FluentAssertions for assertions."
        },
        "useAutoFixture": {
          "type": "boolean",
          "description": "Whether to use AutoFixture to generate test data."
        }
      }
    },
    "codeStyle": {
      "type": "object",
      "required": [ "useFileScopedNamespace", "useAsyncSuffix", "maxLineLength" ],
      "properties": {
        "useFileScopedNamespace": {
          "type": "boolean",
          "description": "Use C# file-scoped namespaces instead of traditional blocks."
        },
        "useAsyncSuffix": {
          "type": "boolean",
          "description": "Require the 'Async' suffix for asynchronous methods."
        },
        "maxLineLength": {
          "type": "integer",
          "minimum": 60,
          "maximum": 200,
          "description": "Maximum line length before wrapping."
        }
      }
    },
    "generationBehavior": {
      "type": "object",
      "required": [ "testStrategy", "splitTestsByMethod", "maxTestsPerClass" ],
      "properties": {
        "testStrategy": {
          "type": "string",
          "enum": [ "Both", "Unit", "Integration" ],
          "description": "The test generation strategy."
        },
        "splitTestsByMethod": {
          "type": "boolean",
          "description": "Split tests into separate files based on the method."
        },
        "maxTestsPerClass": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of test methods per generated class."
        }
      }
    },
    "aiConfiguration": {
      "type": "object",
      "required": [ "model", "temperature", "systemPrompt" ],
      "properties": {
        "model": {
          "type": "string",
          "description": "The AI model to use (e.g. gpt-4o, claude-3-5-sonnet)."
        },
        "temperature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "description": "Model creativity (0.0 = deterministic; higher values = more creative)."
        },
        "systemPrompt": {
          "type": "string",
          "description": "The system prompt that defines the AI role and rules."
        }
      }
    }
  }
}