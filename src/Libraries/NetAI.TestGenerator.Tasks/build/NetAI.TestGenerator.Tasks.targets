<Project>

	<PropertyGroup>
		<TestGeneratorTaskAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\NetAI.TestGenerator.Tasks.dll')">$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\NetAI.TestGenerator.Tasks.dll</TestGeneratorTaskAssembly>
		<TestGeneratorTaskAssembly Condition="'$(TestGeneratorTaskAssembly)' == ''">$(MSBuildThisFileDirectory)NetAI.TestGenerator.Tasks.dll</TestGeneratorTaskAssembly>
		<TestGeneratorTaskExists Condition="Exists('$(TestGeneratorTaskAssembly)')">true</TestGeneratorTaskExists>

		<TestGeneratorActive>false</TestGeneratorActive>
		<TestGeneratorActive Condition="'$(TestGeneratorEnabled)' != 'false' And '$(DesignTimeBuild)' != 'true' And '$(TestGeneratorTaskExists)' == 'true' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">true</TestGeneratorActive>

		<_TestGeneratorFirstTfm Condition="'$(TargetFrameworks)' != ''">$(TargetFrameworks.Split(';')[0])</_TestGeneratorFirstTfm>
		<_TestGeneratorIsFirstTfm>false</_TestGeneratorIsFirstTfm>
		<_TestGeneratorIsFirstTfm Condition="'$(TargetFrameworks)' == '' Or '$(TargetFramework)' == '$(_TestGeneratorFirstTfm)'">true</_TestGeneratorIsFirstTfm>

		<_TestGeneratorIsPublishing>false</_TestGeneratorIsPublishing>
		<_TestGeneratorIsPublishing Condition="'$(_IsPublishing)' == 'true'">true</_TestGeneratorIsPublishing>

		<_TestGeneratorProjectDir>$(MSBuildProjectDirectory)/</_TestGeneratorProjectDir>

		<TestGeneratorSemanticAnalysisEnabled Condition="'$(TestGeneratorSemanticAnalysisEnabled)' == ''">true</TestGeneratorSemanticAnalysisEnabled>
		<TestGeneratorPromptOnly Condition="'$(TestGeneratorPromptOnly)' == ''">false</TestGeneratorPromptOnly>

		<TestGeneratorFailOnError Condition="'$(TestGeneratorFailOnError)' == ''">false</TestGeneratorFailOnError>

		<_TestGeneratorAnalysisDir>$(IntermediateOutputPath)netai\</_TestGeneratorAnalysisDir>

	</PropertyGroup>

	<UsingTask Condition="'$(TestGeneratorTaskExists)' == 'true'"
	           TaskName="NetAI.TestGenerator.Tasks.TestGeneratorTask"
	           AssemblyFile="$(TestGeneratorTaskAssembly)"
	           TaskFactory="TaskHostFactory" />

	<Target Name="TestGeneratorAssemblyMissing"
	        BeforeTargets="PrepareForBuild"
	        Condition="'$(TestGeneratorEnabled)' != 'false' And '$(DesignTimeBuild)' != 'true' And '$(TestGeneratorTaskExists)' != 'true'">
		<Warning Code="TESTGEN001"
		         Text="NetAI.TestGenerator: Task assembly not found ($(TestGeneratorTaskAssembly)). No tests will be generated." />
	</Target>

	<Target Name="SetupTestGeneratorSettings" Condition="'$(TestGeneratorActive)' == 'true'">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\content\aisettings-schema.json"
		      DestinationFiles="$(MSBuildProjectDirectory)\aisettings-schema.json"
		      Condition="!Exists('$(MSBuildProjectDirectory)\aisettings-schema.json') And Exists('$(MSBuildThisFileDirectory)..\content\aisettings-schema.json')" />

		<Copy SourceFiles="$(MSBuildThisFileDirectory)..\content\aisettings.json"
		      DestinationFiles="$(MSBuildProjectDirectory)\aisettings.json"
		      Condition="!Exists('$(MSBuildProjectDirectory)\aisettings.json') And Exists('$(MSBuildThisFileDirectory)..\content\aisettings.json')" />

		<!-- Visible in the IDE, but never copied to bin/publish output (the file may contain an API key and would
		     otherwise flow into every referencing project's output). -->
		<ItemGroup>
			<None Remove="aisettings-schema.json" />
			<None Remove="aisettings.json" />
			<None Include="aisettings-schema.json" CopyToOutputDirectory="Never" />
			<None Include="aisettings.json" CopyToOutputDirectory="Never" />
		</ItemGroup>
	</Target>

	<!-- Runs after reference resolution so that @(ReferencePath) is populated (before PrepareForBuild it is always empty).
	     Publishing runs the build first, so this target also covers 'dotnet publish'. -->
	<Target Name="RunTestGeneration"
	        AfterTargets="ResolveReferences"
	        BeforeTargets="CoreCompile"
	        DependsOnTargets="SetupTestGeneratorSettings"
	        Condition="'$(TestGeneratorActive)' == 'true' And '$(_TestGeneratorIsFirstTfm)' == 'true'">

		<TestGeneratorTask Mode="Generate"
		                   ProjectDir="$(_TestGeneratorProjectDir)"
		                   ProjectName="$(MSBuildProjectName)"
		                   AssemblyName="$(AssemblyName)"
		                   CurrentConfiguration="$(Configuration)"
		                   IsPublishing="$(_TestGeneratorIsPublishing)"
		                   PromptOnly="$(TestGeneratorPromptOnly)"
		                   SourceFiles="@(Compile)"
		                   ReferencePaths="@(ReferencePath)"
		                   DefineConstants="$(DefineConstants)"
		                   UseWpf="$(UseWPF)"
		                   UseWindowsForms="$(UseWindowsForms)"
		                   FailOnError="$(TestGeneratorFailOnError)" />
	</Target>

	<Target Name="RunSemanticTestAnalysis"
	        AfterTargets="ResolveReferences"
	        BeforeTargets="CoreCompile"
	        DependsOnTargets="SetupTestGeneratorSettings"
	        Condition="'$(TestGeneratorActive)' == 'true' And '$(_TestGeneratorIsFirstTfm)' == 'true' And '$(TestGeneratorSemanticAnalysisEnabled)' == 'true'">

		<MakeDir Directories="$(_TestGeneratorAnalysisDir)"
		         Condition="!Exists('$(_TestGeneratorAnalysisDir)')" />

		<TestGeneratorTask Mode="Analyze"
		                   ProjectDir="$(_TestGeneratorProjectDir)"
		                   ProjectName="$(MSBuildProjectName)"
		                   AssemblyName="$(AssemblyName)"
		                   CurrentConfiguration="$(Configuration)"
		                   IsPublishing="$(_TestGeneratorIsPublishing)"
		                   SourceFiles="@(Compile)"
		                   ReferencePaths="@(ReferencePath)"
		                   AnalysisOutputDirectory="$(_TestGeneratorAnalysisDir)"
		                   DefineConstants="$(DefineConstants)"
		                   UseWpf="$(UseWPF)"
		                   UseWindowsForms="$(UseWindowsForms)"
		                   FailOnError="$(TestGeneratorFailOnError)" />
	</Target>

</Project>
