<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<DevelopmentDependency>true</DevelopmentDependency>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<TargetsForTfmSpecificContentInPackage Condition="'$(TargetFramework)' == 'netstandard2.0'">$(TargetsForTfmSpecificContentInPackage);PackCustomTasksAndDependencies</TargetsForTfmSpecificContentInPackage>

		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>


		<!-- Basis-Version Ihres Projekts -->
		<VersionPrefix>1.0.0</VersionPrefix>

		<!-- Generiert einen Zeitstempel im Format: JjJjMmDd.HhMm (z.B. 20261002.1445) -->
		<BuildTimestamp>$([System.DateTime]::Now.ToString("yyyyMMdd.HHmm"))</BuildTimestamp>

		<!-- Kombiniert beides zu einer Preview-Version für lokale Builds -->
		<VersionSuffix>dev.$(BuildTimestamp)</VersionSuffix>

		<!-- Nutzt das Suffix nur im Debug-Modus. Im Release-Modus bleibt es bei der sauberen 1.0.0 -->
		<Version Condition="'$(Configuration)' == 'Debug'">$(VersionPrefix)-$(VersionSuffix)</Version>
		<Version Condition="'$(Configuration)' == 'Release'">$(VersionPrefix)</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>

	<!-- 1. Die JSON-Dateien strukturiert im Paket ablegen -->
	<ItemGroup>
		<None Include="aisettings.json" Pack="true" PackagePath="content/" Condition="Exists('aisettings.json')" />
		<None Include="aisettings-schema.json" Pack="true" PackagePath="content/" Condition="Exists('aisettings-schema.json')" />
	</ItemGroup>

	<!-- 2. WICHTIG: Die .targets-Datei muss mit ins Paket! -->
	<ItemGroup>
		<!-- Zeigt jetzt korrekt in Ihren 'build'-Unterordner auf der Festplatte -->
		<None Include="build\NetAI.TestGenerator.Tasks.targets" Pack="true" PackagePath="build\$(PackageId).targets" />
	</ItemGroup>



	<ItemGroup>
		<ProjectReference Include="..\NetAI.TestGenerator.Core\NetAI.TestGenerator.Core.csproj" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="CleanLocalBuildFolder" BeforeTargets="CopyTaskAndDependenciesToLocalBuildFolder">
		<ItemGroup>
			<_OldBuildFiles Include="$(MSBuildProjectDirectory)\build\*.dll" />
			<_OldBuildFiles Include="$(MSBuildProjectDirectory)\build\*.pdb" />
		</ItemGroup>
		<Delete Files="@(_OldBuildFiles)" />
	</Target>

	<Target Name="CopyTaskAndDependenciesToLocalBuildFolder" AfterTargets="Build">
		<ItemGroup>
			<LocalTaskFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.dll" />
			<LocalTaskFiles Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(LocalTaskFiles)" DestinationFolder="$(MSBuildProjectDirectory)\build\" SkipUnchangedFiles="true"
		      Condition="'@(LocalTaskFiles)' != ''" />
	</Target>

	<Target Name="PackCustomTasksAndDependencies">
		<ItemGroup>
			<_TasksOutputDependencies Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.dll"
			                          Exclude="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\NetAI.TestGenerator.Tasks.dll" />
			<_TasksOutputDependencies Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\*.xml" />

			<TfmSpecificPackageFile
				Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\NetAI.TestGenerator.Tasks.dll">
				<PackagePath>tasks\netstandard2.0\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile
				Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\NetAI.TestGenerator.Tasks.xml"
				Condition="Exists('$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\NetAI.TestGenerator.Tasks.xml')">
				<PackagePath>tasks\netstandard2.0\</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="@(_TasksOutputDependencies)">
				<PackagePath>tasks\netstandard2.0\</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>


	<Target Name="CopyToLocalFeed" AfterTargets="Pack">
		<ItemGroup>
			<GeneratedPackages Include="$(PackageOutputAbsolutePath)\*.nupkg" />
		</ItemGroup>
		<!-- Kopiert das Paket nach jedem erfolgreichen 'dotnet pack' automatisch in Ihren Store -->
		<Copy SourceFiles="@(GeneratedPackages)" DestinationFolder="C:\NuGetLocalSource" SkipUnchangedFiles="false" />
	</Target>


</Project>