		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Bcl.Memory" />
	  <PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>

	


</Project>